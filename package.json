{
  "name": "nexaseller-merchant-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "mysql2": "^3.24.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "vite": "^7.1.0"
  }
}
